[run]
source =
    code_utils_
    features_
    monte_carlo_bankroll
omit =
    */tests/*
    */scripts/*
    */venv/*
    */.venv/*
    */site-packages/*
    app.py
    code_cli_*.py
    code_data_ingest_*.py
    code_core_*.py

[report]
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
